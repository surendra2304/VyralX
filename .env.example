APP_NAME=VyralX
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./data/vyralx.db
DATA_DIR=./data
MEDIA_DIR=./media
RENDER_DIR=./renders
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_UPLOAD_MB=2048
MAX_RENDER_SECONDS=14400
MAX_CONCURRENT_RENDERS=1
DEFAULT_SHORTS_WIDTH=1080
DEFAULT_SHORTS_HEIGHT=1920
DEFAULT_LONG_WIDTH=1920
DEFAULT_LONG_HEIGHT=1080
WORKER_REQUIRED=false
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_TIMEOUT_SECONDS=90
WORKER_MAX_ATTEMPTS=3
FRIDAY_URL=
FRIDAY_API_KEY=
INFERENCE_URL=
INFERENCE_API_KEY=
INFERENCE_GENERATION_PATH=/v1/task/execute
INFERENCE_TIMEOUT_SECONDS=60
INFERENCE_TTS_URL=
INFERENCE_TTS_API_KEY=
INFERENCE_TTS_PATH=/v1/audio/speech
INFERENCE_TTS_MODEL=
INFERENCE_TTS_VOICE=alloy
INFERENCE_TTS_TIMEOUT_SECONDS=180
INTELX_URL=
INTELX_API_KEY=
MEMORA_URL=
MEMORA_API_KEY=
SENTINEL_URL=
SENTINEL_API_KEY=
SENTINEL_REQUIRED_FOR_PUBLISH=false
SENTINEL_POLICY_PATH=
YOUTUBE_DATA_API_KEY=
PEXELS_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube-client-secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube-token.json
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_CATEGORY_ID=28
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_ANALYTICS_ENABLED=false
