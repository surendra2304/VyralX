APP_NAME=VyralX
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_KEY=replace-with-a-long-random-secret
# Oracle Autonomous Database only. PostgreSQL/SQLite are not supported.
# FRIDAY Universe DB — VyralX login/schema. Credentials are read at runtime.
DATABASE_URL=oracle+oracledb://VYRALX:password@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.REGION.oraclecloud.com))(connect_data=(service_name=SERVICE_NAME))(security=(ssl_server_dn_match=yes)))
# VyralX media DB — VYRALX_MEDIA login/schema on the second ADB.
MEDIA_DATABASE_URL=oracle+oracledb://VYRALX_MEDIA:password@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.REGION.oraclecloud.com))(connect_data=(service_name=SERVICE_NAME))(security=(ssl_server_dn_match=yes)))
DATA_DIR=./data
MEDIA_DIR=./media
RENDER_DIR=./renders
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_UPLOAD_MB=2048
MAX_STOCK_CLIP_MB=150
MAX_RENDER_SECONDS=14400
MAX_CONCURRENT_RENDERS=1
RENDER_MAX_CPU_THREADS=1
RENDER_MAX_MEMORY_MB=512
RENDER_AUDIO_LOUDNESS_TARGET_LUFS=-14.0
DEFAULT_SHORTS_WIDTH=1080
DEFAULT_SHORTS_HEIGHT=1920
DEFAULT_LONG_WIDTH=1920
DEFAULT_LONG_HEIGHT=1080
WORKER_REQUIRED=false
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_TIMEOUT_SECONDS=90
WORKER_MAX_ATTEMPTS=3
FRIDAY_URL=
FRIDAY_API_KEY=
INFERENCE_URL=
INFERENCE_API_KEY=
# Optional editorial strategy; lists are comma-separated.
CHANNEL_NAME=
CHANNEL_NICHE=
CHANNEL_CONTENT_PILLARS=
CHANNEL_AVOID_TOPICS=
CHANNEL_BRAND_VOICE=
CHANNEL_CALL_TO_ACTION=
CHANNEL_LANGUAGE=English
INFERENCE_GENERATION_PATH=/v1/task/execute
INFERENCE_TIMEOUT_SECONDS=60
TTS_PROVIDER=espeak
ESPEAK_BIN=espeak-ng
ESPEAK_VOICE=en-us
ESPEAK_RATE=165
INFERENCE_TTS_URL=
INFERENCE_TTS_API_KEY=
INFERENCE_TTS_PATH=/v1/audio/speech
INFERENCE_TTS_MODEL=
INFERENCE_TTS_VOICE=alloy
INFERENCE_TTS_TIMEOUT_SECONDS=180
CAPTION_ALIGNMENT_URL=
CAPTION_ALIGNMENT_API_KEY=
CAPTION_ALIGNMENT_PATH=/v1/align
CAPTION_ALIGNMENT_TIMEOUT_SECONDS=90
CAPTION_ALIGNMENT_LANGUAGE=en
# --- FRIDAY UNIVERSE 10-AGENT MESH ---
FRIDAY_URL=http://friday:10000
FRIDAY_API_KEY=
INFERENCE_URL=http://inference:8000
INFERENCE_API_KEY=
MEMORA_URL=http://memora:8000
MEMORA_API_KEY=
STRATEX_URL=http://stratex:8000
STRATEX_API_KEY=
FORGE_URL=http://forge:8000
FORGE_API_KEY=
CORTEX_URL=http://cortex:8000
CORTEX_API_KEY=
SENTINEL_URL=http://sentinel:8000
SENTINEL_API_KEY=
INTELX_URL=http://intelx:8000
INTELX_API_KEY=
FUTURIS_URL=http://futuris:8000
FUTURIS_API_KEY=
VYRALX_URL=http://vyralx:8000
VYRALX_API_KEY=
# Pre-publish security and policy verification audit gate
SENTINEL_REQUIRED_FOR_PUBLISH=false
SENTINEL_POLICY_PATH=/v1/security/audit
YOUTUBE_DATA_API_KEY=
PEXELS_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube-client-secret.json
YOUTUBE_TOKEN_FILE=./data/secrets/youtube-token.json
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_CATEGORY_ID=28
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_ANALYTICS_ENABLED=false
